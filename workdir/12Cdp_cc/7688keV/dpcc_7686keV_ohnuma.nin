12C(d,p)13C(7.686 MeV,3/2+) CCBA -- Ohnuma case-II mixing-ratio amplitudes
NAMELIST

! ====================================================================== !
!                             Control Parameters                         !
! ====================================================================== !

 &FRESCO  hcm=0.100 rmatch=20.000 rintp=0.20
     hnl=0.200 rnl=20.00 centre=0.00
     jtmin=0.0 jtmax=18.0 absend=0.0000 dry=F rela=' ' nearfa=0
     thmin=0.00 thmax=180.00 thinc=0.50 koords=1 kqmax=0 pp=0
     cutl=0.00 cutr=0.00 cutc=0.00
     ips=0.0100 it0=1 iter=100 fatal=T iblock=8 pade=1 nosol=F psiren=T
     iso=' ' nnu=48 maxl=0 minl=0 mtmin=0 epc=0.0000
     chans=1 listcc=1 treneg=0 cdetr=0 smats=1 xstabl=3 nlpl=0
     waves=0 lampl=-2 veff=1 kfus=0 wdisk=2 bpm=2 melfil=0
     unitmass=1.000000 finec=137.03599
     inh=0 pel=1 exl=1 lab=0 lin=0 lex=0
     elab(1)=16.0000 /

! ====================================================================== !
!                            Partitions (reaction)                       !
! ====================================================================== !

 &PARTITION namep='2H      ' massp=2.0141 zp=1 nex=2 pwf=T
            namet='12C     ' masst=12.0000 zt=6 qval=0.0000 /

 &STATES jp=1.0 ptyp=1 ep=0.0000 cpot=1
         jt=0.0 ptyt=1 et=0.0000 /

 &STATES copyp=1 cpot=1
         jt=2.0 ptyt=1 et=4.4389 /

! ----------------------------------------------------------------- !

 &PARTITION namep='1H      ' massp=1.0078 zp=1 nex=5 pwf=T
            namet='13C     ' masst=13.0033 zt=6 qval=2.7220 /

 ! state #1 : TOTAL
 &STATES jp=0.5 ptyp=1 ep=0.0000 cpot=2
         jt=1.5 ptyt=1 et=7.6860 /

 ! state #2 : 12C(0+) x 1d3/2 only
 &STATES copyp=1 cpot=2
         jt=1.5 ptyt=1 et=7.6860 /

 ! state #3 : 12C(2+) x 2s1/2 only
 &STATES copyp=1 cpot=2
         jt=1.5 ptyt=1 et=7.6860 /

 ! state #4 : 12C(2+) x 1d5/2 only
 &STATES copyp=1 cpot=2
         jt=1.5 ptyt=1 et=7.6860 /

 ! state #5 : 12C(2+) x 1d3/2 only
 &STATES copyp=1 cpot=2
         jt=1.5 ptyt=1 et=7.6860 /

 &PARTITION /

! ====================================================================== !
!                             Potentials                                 !
! ====================================================================== !

! Entrance d + 12C potential and generalized 12C(0+)<->12C(2+) coupling
 &POT kp=1 type=0
      p(1:3)=12.000 0.0000 1.3000 /

 &POT kp=1 type=13 itt=F shape=10
      p(1:3)=0.000 -6.1600 0.0000 /
   &STEP ib=-2 ia=1 k=2 str=-6.160 /

 &POT kp=1 type=1
      p(1:3)=119.600 0.9000 0.8000 /

 &POT kp=1 type=-2
      p(1:7)=0.000 0.0000 0.0000 11.6000 1.4520 0.6210 0.0000 /

 &POT kp=1 type=13 itt=F shape=11
      p(1:3)=0.000 -1.4400 0.0000 /
   &STEP ib=-2 ia=1 k=2 str=-1.440 /

 &POT kp=1 type=3
      p(1:3)=1.300 0.9000 0.8000 /

! ----------------------------------------------------------------- !

! Exit p + 13C optical potential
 &POT kp=2 type=0
      p(1:3)=13.000 0.0000 1.1230 /

 &POT kp=2 type=1
      p(1:3)=55.100 1.1230 0.5700 /

 &POT kp=2 type=2
      p(1:7)=0.000 0.0000 0.0000 8.0000 1.1230 0.5000 0.0000 /

 &POT kp=2 type=3
      p(1:3)=5.500 1.1230 0.5700 /

! ----------------------------------------------------------------- !

! Deuteron n-p binding potential
 &POT kp=3 type=0
      p(1:3)=1.000 0.0000 1.2500 /

 &POT kp=3 type=1 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=3 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=4 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=7 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

! ----------------------------------------------------------------- !

! n + 12C single-particle potential used for the 13C overlaps
 &POT kp=4 type=0
      p(1:3)=13.000 0.0000 1.3000 /

 &POT kp=4 type=1
      p(1:3)=60.000 1.3000 0.7000 /

 &POT kp=4 type=3
      p(1:3)=6.500 1.3000 0.7000 /

 &POT /

! ====================================================================== !
!                        OVERLAPS (form factors)                         !
! ====================================================================== !

! kn=1: deuteron = p+n overlap (unchanged from reference)
 &OVERLAP kn1=1 kn2=2 ic1=1 ic2=2 in=-1
    kind=3 ch1=' ' nn=1 l=0 lmax=2 sn=0.5 ia=1 j=1.5 ib=1
    kbpot=3 krpot=0 be=2.2246 isc=0 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! Experimental neutron threshold used by Ohnuma: Sn ~= 4.946 MeV.
! For Ex=7.686 MeV:
!   0+ core channel: BE = 4.9460 - 7.6860 = -2.7400 MeV
!   2+ core channel: BE = -2.7400 + 4.4389 = +1.6989 MeV
!
! Ohnuma case-II Table 2 mixing ratios for 7.686-MeV 3/2+:
!   12C(0+) x 1d3/2 : 29.70%
!   12C(2+) x 2s1/2 : 68.31%
!   12C(2+) x 1d5/2 : 0.56%
!   12C(2+) x 1d3/2 : 0.35%
! Converted here as |A| = sqrt(mixing fraction).
! Relative signs are NOT supplied by Ohnuma; provisional pattern +,-,+,+ is used.

! kn=2: 13C(7.686,3/2+) = 12C(0+) x 1d3/2
 &OVERLAP kn1=2 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=1.5
    kbpot=4 krpot=0 be=2.7400 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! kn=3: 13C(7.686,3/2+) = 12C(2+,4.4389) x 2s1/2
 &OVERLAP kn1=3 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=2 l=0 sn=0.5 j=0.5
    kbpot=4 krpot=0 be=1.6989 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! kn=4: 13C(7.686,3/2+) = 12C(2+,4.4389) x 1d5/2
 &OVERLAP kn1=4 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=2.5
    kbpot=4 krpot=0 be=1.6989 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! kn=5: 13C(7.686,3/2+) = 12C(2+,4.4389) x 1d3/2
 &OVERLAP kn1=5 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=1.5
    kbpot=4 krpot=0 be=1.6989 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

 &OVERLAP /

! ====================================================================== !
!                             Couplings                                  !
! ====================================================================== !

 &COUPLING icto=2 icfrom=1 kind=7 ip1=0 ip2=-2 ip3=0 /

   ! Common deuteron p+n overlap
   &CFP in=1 ib=1 ia=1 kn=1 a= 1.0000 /

   ! ------------------------------------------------------------
   ! EXIT STATE #1 : TOTAL CCBA -- all four CoSMo components
   ! ------------------------------------------------------------
   &CFP in=2 ib=1 ia=1 kn=2 a= 0.5450 /
   &CFP in=2 ib=1 ia=2 kn=3 a=-0.8265 /
   &CFP in=2 ib=1 ia=2 kn=4 a= 0.07483 /
   &CFP in=2 ib=1 ia=2 kn=5 a= 0.05916 /

   ! ------------------------------------------------------------
   ! EXIT STATE #2 : 12C(0+) x 1d3/2 ONLY
   ! ------------------------------------------------------------
   &CFP in=2 ib=2 ia=1 kn=2 a= 0.5450 /
   &CFP in=2 ib=2 ia=2 kn=3 a= 0.000000 /
   &CFP in=2 ib=2 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=2 ia=2 kn=5 a= 0.000000 /

   ! ------------------------------------------------------------
   ! EXIT STATE #3 : 12C(2+) x 2s1/2 ONLY
   ! ------------------------------------------------------------
   &CFP in=2 ib=3 ia=1 kn=2 a= 0.000000 /
   &CFP in=2 ib=3 ia=2 kn=3 a=-0.8265 /
   &CFP in=2 ib=3 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=3 ia=2 kn=5 a= 0.000000 /

   ! ------------------------------------------------------------
   ! EXIT STATE #4 : 12C(2+) x 1d5/2 ONLY
   ! ------------------------------------------------------------
   &CFP in=2 ib=4 ia=1 kn=2 a= 0.000000 /
   &CFP in=2 ib=4 ia=2 kn=3 a= 0.000000 /
   &CFP in=2 ib=4 ia=2 kn=4 a= 0.07483 /
   &CFP in=2 ib=4 ia=2 kn=5 a= 0.000000 /

   ! ------------------------------------------------------------
   ! EXIT STATE #5 : 12C(2+) x 1d3/2 ONLY
   ! ------------------------------------------------------------
   &CFP in=2 ib=5 ia=1 kn=2 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=3 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=5 a= 0.05916 /

   &CFP in=0 ib=0 ia=0 kn=0 a= 0.0000 /

! Retain the coupled-channel interaction in partition 1.
 &COUPLING icto=0 icfrom=1 kind=1 ip1=0 ip2=0 ip3=0 /

! ******* END OF FRESCO INPUTS *******
