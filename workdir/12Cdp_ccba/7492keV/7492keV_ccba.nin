12C(d,p)13C(7.492 MeV,7/2+) CCBA | FSU9 | 3089-keV reference workflow
NAMELIST

! Fresh comparison based on the successful low-lying-state CCBA workflow.
! Entrance OMP, generalized Coulomb/nuclear coupling (SHAPE=10/11),
! deuteron potential, target radial geometry and finite-range operator
! IP1=0, IP2=-2 are retained from the reference calculations.
! Core: 12C(0+) and 12C(2+,4.4389 MeV); final: 13C(7/2+,7.4920 MeV).
! FSU9 signed amplitudes are used directly, without additional normalization,
! recoil correction or phase conversion.
!
! FSU9 structure for the 7.492-MeV 7/2+ state:
!   12C(2+) x 1d5/2 : a = +0.965492
!   12C(2+) x 1d3/2 : a = -0.059365
! There is no 12C(0+) component in the adopted FSU9 plan.
!
! BOUND-STATE RADIAL FUNCTIONS:
! Adopt Sn(13C)=4.9460 MeV, consistent with the other low-lying-state cards.
! Relative to the 12C(2+,4.4389-MeV) core,
!   BE = Sn + E(2+) - Ex = 4.9460 + 4.4389 - 7.4920 = +1.8929 MeV.
! Thus both included FSU9 channels are CLOSED and physically bound relative
! to the excited-core threshold. No artificial positive-BE prescription is
! needed for this state because no 0+ core overlap is included.
!
! Solver: IBLOCK=2 couples exactly the TWO entrance excitation pairs;
! IT0=ITER=1 and ICTO=-2 give one-way first-order transfer (CCBA).
! PADE=0 is retained from the corrected low-lying-state workflow.
! Incident LAB/LIN/LEX are set to 1 for the Ed=16-MeV laboratory beam.
!
! JCEfresco split.py output map:
!   elastic.txt : d + 12C(0+) elastic scattering
!   state1.txt  : d + 12C(2+) inelastic scattering
!   state2.txt  : 13C(7.492) TOTAL coherent CCBA transfer
!   state3.txt  : 12C(2+) x 1d5/2 component only
!   state4.txt  : 12C(2+) x 1d3/2 component only
! The isolated component curves do not sum incoherently to the coherent total.
! KN=1..2 are reserved for the reference deuteron coupled radial components;
! target radial functions therefore start at KN=3.

! ====================================================================== !
!                             Control Parameters                         !
! ====================================================================== !

 &FRESCO  hcm=0.100 rmatch=20.000 rintp=0.20
     hnl=0.200 rnl=20.00 centre=0.00
     jtmin=0.0 jtmax=18.0 absend=0.0000 dry=F rela=' ' nearfa=0
     thmin=0.00 thmax=180.00 thinc=0.50 koords=1 kqmax=0 pp=0
     cutl=0.00 cutr=0.00 cutc=0.00
     ips=0.0 it0=1 iter=1 fatal=T iblock=2 pade=0 nosol=F psiren=T
     iso=' ' nnu=48 maxl=0 minl=0 mtmin=0 epc=0.0000
     chans=1 listcc=1 treneg=0 cdetr=0 smats=1 xstabl=3 nlpl=0
     waves=0 lampl=-2 veff=1 kfus=0 wdisk=2 bpm=2 melfil=0
     unitmass=1.000000 finec=137.03599
     inh=0 pel=1 exl=1 lab=1 lin=1 lex=1
     elab(1)=16.0000 /

! ====================================================================== !
!                            Partitions (reaction)                       !
! ====================================================================== !

 &PARTITION namep='2H      ' massp=2.0141 zp=1 nex=2 pwf=T
            namet='12C     ' masst=12.0000 zt=6 qval=0.0000 /

 &STATES jp=1.0 ptyp=1 ep=0.0000 cpot=1
         jt=0.0 ptyt=1 et=0.0000 /

 &STATES copyp=1 cpot=1
         jt=2.0 ptyt=1 et=4.4389 /

! ----------------------------------------------------------------- !

 &PARTITION namep='1H      ' massp=1.0078 zp=1 nex=3 pwf=T
            namet='13C     ' masst=13.0033 zt=6 qval=2.7220 /

 ! Exit #1 / JCEfresco state2.txt : TOTAL coherent CCBA transfer
 &STATES jp=0.5 ptyp=1 ep=0.0000 cpot=2
         jt=3.5 ptyt=1 et=7.4920 /

 ! Exit #2 / JCEfresco state3.txt : 2+ x 1d5/2 only
 &STATES copyp=1 cpot=2
         jt=3.5 ptyt=1 et=7.4920 /

 ! Exit #3 / JCEfresco state4.txt : 2+ x 1d3/2 only
 &STATES copyp=1 cpot=2
         jt=3.5 ptyt=1 et=7.4920 /

 &PARTITION /

! ====================================================================== !
!                             Potentials                                 !
! ====================================================================== !

! Entrance d + 12C potential and generalized 12C(0+)<->12C(2+) coupling
 &POT kp=1 type=0
      p(1:3)=12.000 0.0000 1.3000 /

 &POT kp=1 type=13 itt=F shape=10
      p(1:3)=0.000 -6.1600 0.0000 /
   &STEP ib=-2 ia=1 k=2 str=-6.160 /

 &POT kp=1 type=1
      p(1:3)=119.600 0.9000 0.8000 /

 &POT kp=1 type=-2
      p(1:7)=0.000 0.0000 0.0000 11.6000 1.4520 0.6210 0.0000 /

 &POT kp=1 type=13 itt=F shape=11
      p(1:3)=0.000 -1.4400 0.0000 /
   &STEP ib=-2 ia=1 k=2 str=-1.440 /

 &POT kp=1 type=3
      p(1:3)=1.300 0.9000 0.8000 /

! ----------------------------------------------------------------- !

! Exit p + 13C optical potential
! Ohnuma energy prescription evaluated for Ex(13C)=7.4920 MeV.
! Ecm(in) = 16*12/(12+2.0141) = 13.700487 MeV
! Qeff    = 2.7220 - 7.4920     = -4.770000 MeV
! Ecm(out)= 8.930487 MeV
!
! V  = 63.1 - 0.3*Ecm = 60.420854 MeV
! WD = 10.37 - 0.06*Ecm = 9.834171 MeV
! r  = 1.15 - 0.001*Ecm = 1.141070 fm

 &POT kp=2 type=0
      p(1:3)=13.000 0.0000 1.141070 /

 &POT kp=2 type=1
      p(1:3)=60.420854 1.141070 0.5700 /

 &POT kp=2 type=2
      p(1:7)=0.0000 0.0000 0.0000 9.834171 1.141070 0.5000 0.0000 /

 &POT kp=2 type=3
      p(1:3)=5.500 1.141070 0.5700 /

! ----------------------------------------------------------------- !

! Deuteron n-p binding potential
 &POT kp=3 type=0
      p(1:3)=1.000 0.0000 1.2500 /

 &POT kp=3 type=1 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=3 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=4 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=7 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

! ----------------------------------------------------------------- !

! n + 12C bound-state potential used for the 13C overlaps
 &POT kp=4 type=0
      p(1:3)=13.000 0.0000 1.3000 /

 &POT kp=4 type=1
      p(1:3)=60.000 1.3000 0.7000 /

 &POT kp=4 type=3
      p(1:3)=6.500 1.3000 0.7000 /

 &POT /

! ====================================================================== !
!                        OVERLAPS (form factors)                         !
! ====================================================================== !

! KN=1..2: deuteron = p+n coupled radial components (unchanged)
 &OVERLAP kn1=1 kn2=2 ic1=1 ic2=2 in=-1
    kind=3 ch1=' ' nn=1 l=0 lmax=2 sn=0.5 ia=1 j=1.5 ib=1
    kbpot=3 krpot=0 be=2.2246 isc=0 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! KN=3: 13C(7.492,7/2+) = 12C(2+,4.4389) x 1d5/2
! BE = 4.9460 + 4.4389 - 7.4920 = 1.8929 MeV
 &OVERLAP kn1=3 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=2.5
    kbpot=4 krpot=0 be=1.8929 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! KN=4: 13C(7.492,7/2+) = 12C(2+,4.4389) x 1d3/2
! BE = 4.9460 + 4.4389 - 7.4920 = 1.8929 MeV
 &OVERLAP kn1=4 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=1.5
    kbpot=4 krpot=0 be=1.8929 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

 &OVERLAP /

! ====================================================================== !
!                             Couplings                                  !
! ====================================================================== !

 &COUPLING icto=-2 icfrom=1 kind=7 ip1=0 ip2=-2 ip3=0 /

   ! Common deuteron p+n overlap
   &CFP in=1 ib=1 ia=1 kn=1 a= 1.000000 /

   ! ------------------------------------------------------------
   ! EXIT #1 / state2.txt : TOTAL coherent CCBA
   ! ------------------------------------------------------------
   &CFP in=2 ib=1 ia=2 kn=3 a= 0.965492 /
   &CFP in=2 ib=1 ia=2 kn=4 a=-0.059365 /

   ! ------------------------------------------------------------
   ! EXIT #2 / state3.txt : 12C(2+) x 1d5/2 ONLY
   ! ------------------------------------------------------------
   &CFP in=2 ib=2 ia=2 kn=3 a= 0.965492 /
   &CFP in=2 ib=2 ia=2 kn=4 a= 0.000000 /

   ! ------------------------------------------------------------
   ! EXIT #3 / state4.txt : 12C(2+) x 1d3/2 ONLY
   ! ------------------------------------------------------------
   &CFP in=2 ib=3 ia=2 kn=3 a= 0.000000 /
   &CFP in=2 ib=3 ia=2 kn=4 a=-0.059365 /

   &CFP in=0 ib=0 ia=0 kn=0 a=0.000000 /

! Empty coupling terminates input; generalized entrance couplings above
! already define 12C(0+) <-> 12C(2+).
 &COUPLING /

! ******* END OF FRESCO INPUTS *******
