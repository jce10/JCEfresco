12C(d,p)13C(6.864 MeV,5/2+) CCBA | FSU9 | 3089-keV reference workflow
NAMELIST

! Fresh comparison based on dpcc_3089keV3(5).nin.
! Entrance OMP, generalized Coulomb/nuclear coupling (SHAPE=10/11),
! deuteron potential, target radial geometry and finite-range operator
! IP1=0, IP2=-2 are retained from that successful reference.
! Core: 12C(0+) and 12C(2+,4.4389 MeV); final: 13C(5/2+,6.8640 MeV).
! FSU9 signed amplitudes below are the user's supplied plan, without
! additional normalization, recoil correction or phase conversion.
! Their phase relative to the adopted collective coupling remains provisional.
!
! RADIAL APPROXIMATION -- NOT AN EXPLICIT CONTINUUM RESONANCE:
! Adopt Sn(13C)=4.9460 MeV, matching the 3089-keV reference.
! Physical BE(0+ core)=Sn-Ex=-1.9180 MeV: this neutron channel is OPEN.
! KN=3 uses artificial bound BE=+1.9180, following the previous comparison
! prescription |Sn-Ex|. This is not the physical resonance wave function.
! KN=4..6 use physical closed-channel BE=Sn+4.4389-6.8640=+2.5209 MeV.
! Previous card used Sn=4.9499 implicitly (+1.9141 / +2.5248); values
! here are made consistent with the lower-state reference's Sn=4.9460.
! A resonance bin needs a specified energy window and calibrated scattering
! potential. Simply negating BE does not establish that calculation.
!
! Solver: IBLOCK=2 couples exactly the TWO entrance excitation pairs;
! IT0=ITER=1 and ICTO=-2 give one-way first-order transfer (CCBA).
! IBLOCK=8 from the reference is not copied: it extends beyond the entrance
! pairs. PADE=0 is used for this one-step calculation.
! Incident LAB/LIN/LEX explicitly set to 1 (beam Ed=16 MeV).
! Output angles and cross sections are in the center-of-mass frame.
! All five exit copies have identical energy/spin/OMP and independent CFPs.
! They are diagnostic copies of one state, not five physical states.
! Isolated cross sections do not sum to the coherent total.
!
! Output map: exit 1 total; exit 2 0+ x d5/2; exit 3 2+ x d5/2;
!             exit 4 2+ x d3/2; exit 5 2+ x s1/2.
! KN=1..2 reserved for reference deuteron coupled radial components;
! target radial functions start at KN=3.
! Structural validation only; no FRESCO/FrescoX executable available here.
! References for input semantics:
! https://www.fresco.org.uk/input3.4/fresco-namelist-manual/node6.html
! https://www.fresco.org.uk/input3.4/fresco-namelist-manual/node9.html
! https://www.fresco.org.uk/input3.4/fresco-namelist-manual/node10.html

! CONTROL PARAMETERS
 &FRESCO  hcm=0.100 rmatch=20.000 rintp=0.20
     hnl=0.200 rnl=20.00 centre=0.00
     jtmin=0.0 jtmax=18.0 absend=0.0000 dry=F rela=' ' nearfa=0
     thmin=0.00 thmax=180.00 thinc=0.50 koords=1 kqmax=0 pp=0
     cutl=0.00 cutr=0.00 cutc=0.00
     ips=0.0 it0=1 iter=1 fatal=T iblock=2 pade=0 nosol=F psiren=T
     iso=' ' nnu=48 maxl=0 minl=0 mtmin=0 epc=0.0000
     chans=1 listcc=1 treneg=0 cdetr=0 smats=1 xstabl=3 nlpl=0
     waves=0 lampl=-2 veff=1 kfus=0 wdisk=2 bpm=2 melfil=0
     unitmass=1.000000 finec=137.03599
     inh=0 pel=1 exl=1 lab=1 lin=1 lex=1
     elab(1)=16.0000 /

! ENTRANCE PARTITION
 &PARTITION namep='2H      ' massp=2.0141 zp=1 nex=2 pwf=T
            namet='12C     ' masst=12.0000 zt=6 qval=0.0000 /

 &STATES jp=1.0 ptyp=1 ep=0.0000 cpot=1
         jt=0.0 ptyt=1 et=0.0000 /

 &STATES copyp=1 cpot=1
         jt=2.0 ptyt=1 et=4.4389 /

! EXIT PARTITION AND DIAGNOSTIC COPIES
 &PARTITION namep='1H      ' massp=1.0078 zp=1 nex=5 pwf=T
            namet='13C     ' masst=13.0033 zt=6 qval=2.7220 /

 ! Exit #1: TOTAL
 &STATES jp=0.5 ptyp=1 ep=0.0000 cpot=2
         jt=2.5 ptyt=1 et=6.8640 /

 ! Exit #2: 0+ x 1d5/2 only
 &STATES copyp=1 cpot=2
         jt=2.5 ptyt=1 et=6.8640 /

 ! Exit #3: 2+ x 1d5/2 only
 &STATES copyp=1 cpot=2
         jt=2.5 ptyt=1 et=6.8640 /

 ! Exit #4: 2+ x 1d3/2 only
 &STATES copyp=1 cpot=2
         jt=2.5 ptyt=1 et=6.8640 /

 ! Exit #5: 2+ x 2s1/2 only
 &STATES copyp=1 cpot=2
         jt=2.5 ptyt=1 et=6.8640 /

 &PARTITION /

! POTENTIALS
! Entrance d + 12C potential and generalized 12C(0+)<->12C(2+) coupling
 &POT kp=1 type=0
      p(1:3)=12.000 0.0000 1.3000 /

 &POT kp=1 type=13 itt=F shape=10
      p(1:3)=0.000 -6.1600 0.0000 /
   &STEP ib=-2 ia=1 k=2 str=-6.160 /

 &POT kp=1 type=1
      p(1:3)=119.600 0.9000 0.8000 /

 &POT kp=1 type=-2
      p(1:7)=0.000 0.0000 0.0000 11.6000 1.4520 0.6210 0.0000 /

 &POT kp=1 type=13 itt=F shape=11
      p(1:3)=0.000 -1.4400 0.0000 /
   &STEP ib=-2 ia=1 k=2 str=-1.440 /

 &POT kp=1 type=3
      p(1:3)=1.300 0.9000 0.8000 /

! Exit p + 13C OMP: same Ohnuma energy prescription as reference.
! Ecm(in)=16*12/(12+2.0141)=13.700487 MeV.
! Qeff=2.7220-6.8640=-4.142000 MeV; Ecm(out)=9.558487 MeV.
! V=63.1-0.3*Ecm; WD=10.37-0.06*Ecm; r=1.15-0.001*Ecm.
! Spin-orbit depth 5.5 and diffuseness values retained from reference.
 &POT kp=2 type=0 p(1:3)=13.000 0.0000 1.140442 /
 &POT kp=2 type=1 p(1:3)=60.232454 1.140442 0.5700 /
 &POT kp=2 type=2
      p(1:7)=0.0000 0.0000 0.0000 9.796491 1.140442 0.5000 0.0000 /
 &POT kp=2 type=3 p(1:3)=5.500 1.140442 0.5700 /

! Deuteron n-p binding potential
 &POT kp=3 type=0
      p(1:3)=1.000 0.0000 1.2500 /

 &POT kp=3 type=1 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=3 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=4 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=7 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

! ----------------------------------------------------------------- !

! Reference target radial potential (radius convention retained).
! Central depth is adjusted separately for each positive-BE radial function.
 &POT kp=4 type=0
      p(1:3)=13.000 0.0000 1.3000 /

 &POT kp=4 type=1
      p(1:3)=60.000 1.3000 0.7000 /

 &POT kp=4 type=3
      p(1:3)=6.500 1.3000 0.7000 /

 &POT /

! OVERLAPS
! kn=1: deuteron = p+n overlap (unchanged from reference)
 &OVERLAP kn1=1 kn2=2 ic1=1 ic2=2 in=-1
    kind=3 ch1=' ' nn=1 l=0 lmax=2 sn=0.5 ia=1 j=1.5 ib=1
    kbpot=3 krpot=0 be=2.2246 isc=0 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! KN=3: 13C(6.864,5/2+) = 12C(0+) x 1d5/2
! Artificial bound approximation for the open neutron channel.
 &OVERLAP kn1=3 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=2.5
    kbpot=4 krpot=0 be=1.9180 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! KN=4: 13C(6.864,5/2+) = 12C(2+,4.4389) x 1d5/2
! Closed channel relative to the excited-core threshold.
 &OVERLAP kn1=4 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=2.5
    kbpot=4 krpot=0 be=2.5209 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! KN=5: 13C(6.864,5/2+) = 12C(2+,4.4389) x 1d3/2
! Closed channel relative to the excited-core threshold.
 &OVERLAP kn1=5 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=1.5
    kbpot=4 krpot=0 be=2.5209 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! KN=6: 13C(6.864,5/2+) = 12C(2+,4.4389) x 2s1/2
! Closed channel relative to the excited-core threshold.
 &OVERLAP kn1=6 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=2 l=0 sn=0.5 j=0.5
    kbpot=4 krpot=0 be=2.5209 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

 &OVERLAP /

! COUPLINGS
 &COUPLING icto=-2 icfrom=1 kind=7 ip1=0 ip2=-2 ip3=0 /
   &CFP in=1 ib=1 ia=1 kn=1 a= 1.000000 /

   ! Exit #2: TOTAL
   &CFP in=2 ib=1 ia=1 kn=3 a=0.043160 /
   &CFP in=2 ib=1 ia=2 kn=4 a=0.474177 /
   &CFP in=2 ib=1 ia=2 kn=5 a=-0.003448 /
   &CFP in=2 ib=1 ia=2 kn=6 a=-0.857049 /

   ! Exit #3: 0+ x 1d5/2 only
   &CFP in=2 ib=2 ia=1 kn=3 a= 0.043160 /
   &CFP in=2 ib=2 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=2 ia=2 kn=5 a= 0.000000 /
   &CFP in=2 ib=2 ia=2 kn=6 a= 0.000000 /

   ! Exit #4: 2+ x 1d5/2 only
   &CFP in=2 ib=3 ia=1 kn=3 a= 0.000000 /
   &CFP in=2 ib=3 ia=2 kn=4 a= 0.474177 /
   &CFP in=2 ib=3 ia=2 kn=5 a= 0.000000 /
   &CFP in=2 ib=3 ia=2 kn=6 a= 0.000000 /

   ! Exit #5: 2+ x 1d3/2 only
   &CFP in=2 ib=4 ia=1 kn=3 a= 0.000000 /
   &CFP in=2 ib=4 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=4 ia=2 kn=5 a= -0.003448 /
   &CFP in=2 ib=4 ia=2 kn=6 a= 0.000000 /

   ! Exit #6: 2+ x 2s1/2 only
   &CFP in=2 ib=5 ia=1 kn=3 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=5 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=6 a= -0.857049 /

   &CFP in=0 ib=0 ia=0 kn=0 a=0.000000 /

 ! Empty coupling terminates input; generalized entrance couplings above
 ! already define 12C(0+) <-> 12C(2+).
 &COUPLING /
! END OF FRESCO INPUT
