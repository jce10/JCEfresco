12C(d,p)13C | Ed=16 MeV | CCBA | Ex=3.684 MeV | Jpi=3/2- | CoSMo FSU9 raw signed amplitudes
NAMELIST

! ======================================================================
! CoSMo / FSU9 COMPARISON -- RAW SIGNED AMPLITUDES
! ======================================================================
! Experimental state: 13C(3.684 MeV, 3/2-)
!
! FSU9 components from the low-lying-state plan:
!   KN=3: 12C(0+1) x 1p3/2 : a=+0.383122
!   KN=4: 12C(2+1) x 1p1/2 : a=-0.922148
!   KN=5: 12C(2+1) x 1p3/2 : a=+0.563289
!
! The amplitudes below are used exactly with the signs listed above.
! No overall phase flip, renormalization, or spectroscopic-factor square root
! is applied. Total and isolated-component exits use identical amplitudes.
!
! Experimental kinematics are used for the reaction calculation:
!   Ex(13C)       = 3.6840 MeV
!   Ex(12C 2+1)   = 4.4389 MeV
!   Sn(13C)       = Q(d,p) + Bd = 2.7217 + 2.2246 = 4.9463 MeV
!   BE[0+ core]    = 4.9463 - 3.6840 = 1.2623 MeV
!   BE[2+ core]    = 1.2623 + 4.4389 = 5.7012 MeV
!
! Exit p+13C Ohnuma energy-dependent OMP uses the outgoing relative energy:
!   Ecm,in  = 16*12/(12+2.0141) = 13.70049 MeV
!   Ecm,out = Ecm,in + 2.7217 - 3.6840 = 12.73819 MeV
!   V       = 63.1 - 0.3*Ecm,out   = 59.2785 MeV
!   WD      = 10.37 - 0.06*Ecm,out = 9.6057 MeV
!   r       = 1.15 - 0.001*Ecm,out = 1.1373 fm
!
! EXIT OUTPUTS:
!   1 = coherent TOTAL
!   2 = 0+1 x 1p3/2
!   3 = 2+1 x 1p1/2
!   4 = 2+1 x 1p3/2
! Component exits are diagnostic copies; their cross sections are not to be
! added incoherently to reconstruct the coherent total.
! ======================================================================

! ================================================
! FRESCO CONTROL PARAMETERS
! ================================================
 &FRESCO  hcm= 0.100 rmatch=  55.000 rintp=  0.20
     hnl= 0.200 rnl= 30.00 centre= -6.00
     jtmin=  0.0 jtmax=    20.0 absend=  0.0000 dry=F rela=' ' nearfa= 0
     thmin=  0.00 thmax= 60.00 thinc=  0.50 koords=1 kqmax=0 pp=0
     cutl=  0.00 cutr=  0.00 cutc=  0.00
     ips= 0.0000  it0=1 iter=  1 fatal=T iblock= 2 pade=0 nosol=F psiren=T
     iso=' ' nnu= 48 maxl=   0 minl=  0 mtmin= 0 epc= 0.0000
     erange=  0.0000  dk=  0.0010
     chans= 1 listcc= 1 treneg= 0 cdetr= 0 smats= 2 xstabl= 3 nlpl= 0
     waves= 0 lampl=-3 veff= 1 kfus= 0 wdisk= 0 bpm= 1 melfil= 0
     unitmass= 1.000000 finec=137.03599
     inh=0 pel=1 exl= 1 lab=1 lin=1 lex= 1
     elab(1)=    16.0000 /


! ================================================
! PARTITIONS AND STATES
! ================================================
 &PARTITION namep='2H      ' massp=  2.0141 zp=  1 nex= 2 pwf=T
            namet='12C     ' masst= 12.0000 zt=  6 qval=  0.0000/
 &STATES jp= 1.0 ptyp= 1 ep=  0.0000  cpot=  1
         jt= 0.0 ptyt= 1 et=  0.0000/
 ! Entrance excitation #2: same deuteron, excited 12C core
 &STATES copyp=1 cpot=1
         jt=2.0 ptyt=1 et=4.4389 /

 ! Exit #1 is the coherent FSU9 total.
 ! Exit #2-4 are independent diagnostic copies with the same exit OMP.
 &PARTITION namep='1H' massp=1.0078 zp=1 nex=4 pwf=T
            namet='13C' masst=13.0034 zt=6 qval=2.7217 /
 ! #1: TOTAL
 &STATES jp=0.5 ptyp=1 ep=0.0000 cpot=2
         jt=1.5 ptyt=-1 et=3.6840 /
 ! #2: 0+1 x 1p3/2 only
 &STATES copyp=1 cpot=2 jt=1.5 ptyt=-1 et=3.6840 /
 ! #3: 2+1 x 1p1/2 only
 &STATES copyp=1 cpot=2 jt=1.5 ptyt=-1 et=3.6840 /
 ! #4: 2+1 x 1p3/2 only
 &STATES copyp=1 cpot=2 jt=1.5 ptyt=-1 et=3.6840 /
 &partition /   ! END OF DEFINING PARTITIONS


! ================================================
! POTENTIALS
! ================================================
 ! Entrance d+12C OMP and 0+ <-> 2+ coupling retained from the prior card.
 &pot kp=1 type=0 p(1:3)=12.000 0.0000 1.3000 /
 &pot kp=1 type=13 itt=F shape=10 p(1:3)=0.000 -6.1600 0.0000 /
   &step ib=-2 ia=1 k=2 str=-6.1600 /
 &pot kp=1 type=1 p(1:3)=110.700 0.9000 0.8010 /
 &pot kp=1 type=-2
      p(1:7)=0.0000 0.0000 0.0000 9.2000 1.4200 0.7940 0.0000 /
 &pot kp=1 type=13 itt=F shape=10 p(1:3)=0.000 -1.4400 0.0000 /
   &step ib=-2 ia=1 k=2 str=-1.4400 /
 &pot kp=1 type=3 p(1:3)=4.660 0.9000 0.5510 /

 ! Exit p+13C Ohnuma OMP at Ecm(out)=12.73819 MeV.
 &pot kp=2 type=0 p(1:3)=13.000 0.0000 1.1373 /
 &pot kp=2 type=1 p(1:3)=59.279 1.1373 0.5700 /
 &pot kp=2 type=2
      p(1:7)=0.0000 0.0000 0.0000 9.6057 1.1373 0.5000 0.0000 /
 &pot kp=2 type=3 p(1:3)=5.500 1.1373 0.5700 /

 ! n-p deuteron binding interaction
 &pot kp=3 type=0
      p(1:3)=1.000 0.0000 1.2500 /
 &pot kp=3 type=1 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /
 &pot kp=3 type=3 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /
 &pot kp=3 type=4 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /
 &pot kp=3 type=7 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 ! n+12C bound-state geometry
 &pot kp=4 type=0
      p(1:3)=12.000 0.0000 1.2500 /
 &pot kp=4 type=1
      p(1:3)=50.000 1.2500 0.6500 /
 &pot kp=4 type=3
      p(1:3)=6.000 1.2500 0.6500 /
 &pot /   ! END OF DEFINING POTENTIALS


! ================================================
! OVERLAPS
! ================================================
 ! Deuteron overlap
 &OVERLAP kn1=1 kn2=2 ic1=1 ic2=2 in=-1
    kind=3 ch1=' ' nn=1 l=0 lmax=2 sn=0.5 ia=1 j=1.5 ib=1
    kbpot=3 krpot=0 be=2.2246 isc=0 ipc=3 nfl=0 nam=0 ampl=0.0000 /

 ! KN=3: 13C(3/2-) = 12C(0+1) x 1p3/2
 &OVERLAP kn1=3 kn2=0 ic1=1 ic2=2 in=-2
    kind=0 nn=1 l=1 sn=0.5 j=1.5 ia=1 ib=1
    kbpot=4 krpot=0 be=1.2623 isc=1 ipc=1 nfl=0 nam=0 ampl=0.0000 /

 ! KN=4: 13C(3/2-) = 12C(2+1) x 1p1/2
 &OVERLAP kn1=4 kn2=0 ic1=1 ic2=2 in=-2
    kind=0 nn=1 l=1 sn=0.5 j=0.5 ia=2 ib=1
    kbpot=4 krpot=0 be=5.7012 isc=1 ipc=1 nfl=0 nam=0 ampl=0.0000 /

 ! KN=5: 13C(3/2-) = 12C(2+1) x 1p3/2
 &OVERLAP kn1=5 kn2=0 ic1=1 ic2=2 in=-2
    kind=0 nn=1 l=1 sn=0.5 j=1.5 ia=2 ib=1
    kbpot=4 krpot=0 be=5.7012 isc=1 ipc=1 nfl=0 nam=0 ampl=0.0000 /
 &overlap /   ! END OF DEFINING OVERLAPS


! ================================================
! COUPLINGS
! ================================================
 ! CCBA: entrance 0+/2+ waves coupled to all orders; transfer performed once.
 &COUPLING icto=-2 icfrom=1 kind=7 ip1=0 ip2=-1 ip3=0 /
   &cfp in=1 ib=1 ia=1 kn=1 a=1.0000 /

 ! Exit #1 TOTAL: all three raw signed FSU9 amplitudes.
   &cfp in=2 ib=1 ia=1 kn=3 a=+0.383122 /
   &cfp in=2 ib=1 ia=2 kn=4 a=-0.922148 /
   &cfp in=2 ib=1 ia=2 kn=5 a=+0.563289 /

 ! Exit #2: 0+1 x 1p3/2
   &cfp in=2 ib=2 ia=1 kn=3 a=+0.383122 /
 ! Exit #3: 2+1 x 1p1/2
   &cfp in=2 ib=3 ia=2 kn=4 a=-0.922148 /
 ! Exit #4: 2+1 x 1p3/2
   &cfp in=2 ib=4 ia=2 kn=5 a=+0.563289 /
   &cfp in=0 /
 &COUPLING /
 ! END OF FRESCO INPUT
