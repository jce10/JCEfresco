12C(d,p)13C(8.200 MeV,3/2+) CCBA | FSU9 | 3089-keV reference workflow
NAMELIST

! ======================================================================
! 8.20-MeV SUPER-RADIANT 3/2+ STATE
! ======================================================================
! Entrance-channel model, collective 12C(0+)<->12C(2+) coupling,
! deuteron treatment, finite-range transfer operator and radial geometry
! follow the established 16-MeV CCBA reference workflow.
!
! Final-state FSU9 signed spectroscopic amplitudes:
!   0+ x 1d3/2 : -0.693451
!   2+ x 1d5/2 : +0.626193
!   2+ x 1d3/2 : +0.219101
!   2+ x 2s1/2 : -0.041683
!
! No additional normalization, recoil correction or phase conversion
! has been applied to the supplied FSU9 amplitudes.
!
! RADIAL APPROXIMATION -- NOT AN EXPLICIT CONTINUUM RESONANCE:
! Adopt Sn(13C)=4.9460 MeV.
! Physical BE(0+ core)=Sn-Ex=4.9460-8.2000=-3.2540 MeV: OPEN channel.
! KN=3 uses the artificial bound-state magnitude BE=+3.2540 MeV,
! consistent with the previous comparison prescription.
! For the 12C(2+,4.4389-MeV) core:
! BE=Sn+4.4389-8.2000=+1.1849 MeV, so KN=4..6 are closed.
!
! The 8.2-MeV state is broad; this card is therefore a discrete-state
! CCBA comparison and does NOT model the full continuum line shape/width.
!
! Solver: IBLOCK=2 couples the two entrance excitation pairs.
! IT0=ITER=1 and ICTO=-2 give one-way first-order transfer (CCBA).
! Incident beam is Ed(lab)=16 MeV.
! Output angles/cross sections are in the center-of-mass frame.
!
! FRESCO/JCEfresco output ordering:
!   state1.txt = entrance 12C(2+) inelastic scattering
!   state2.txt = TOTAL CCBA transfer to 8.20-MeV 3/2+
!   state3.txt = 0+ x 1d3/2 only
!   state4.txt = 2+ x 1d5/2 only
!   state5.txt = 2+ x 1d3/2 only
!   state6.txt = 2+ x 2s1/2 only
!
! Diagnostic component copies are not separate physical states.
! Their isolated cross sections do not sum incoherently to the total.
! ======================================================================

! CONTROL PARAMETERS
 &FRESCO  hcm=0.100 rmatch=20.000 rintp=0.20
     hnl=0.200 rnl=20.00 centre=0.00
     jtmin=0.0 jtmax=18.0 absend=0.0000 dry=F rela=' ' nearfa=0
     thmin=0.00 thmax=180.00 thinc=0.50 koords=1 kqmax=0 pp=0
     cutl=0.00 cutr=0.00 cutc=0.00
     ips=0.0 it0=1 iter=1 fatal=T iblock=2 pade=0 nosol=F psiren=T
     iso=' ' nnu=48 maxl=0 minl=0 mtmin=0 epc=0.0000
     chans=1 listcc=1 treneg=0 cdetr=0 smats=1 xstabl=3 nlpl=0
     waves=0 lampl=-2 veff=1 kfus=0 wdisk=2 bpm=2 melfil=0
     unitmass=1.000000 finec=137.03599
     inh=0 pel=1 exl=1 lab=1 lin=1 lex=1
     elab(1)=16.0000 /

! ======================================================================
! PARTITIONS AND STATES
! ======================================================================

! ENTRANCE: d + 12C
 &PARTITION namep='2H      ' massp=2.0141 zp=1 nex=2 pwf=T
            namet='12C     ' masst=12.0000 zt=6 qval=0.0000 /

 &STATES jp=1.0 ptyp=1 ep=0.0000 cpot=1
         jt=0.0 ptyt=1 et=0.0000 /

 &STATES copyp=1 cpot=1
         jt=2.0 ptyt=1 et=4.4389 /

! EXIT: p + 13C(8.20 MeV,3/2+)
! Five copies: coherent total + four isolated structural components.
 &PARTITION namep='1H      ' massp=1.0078 zp=1 nex=5 pwf=T
            namet='13C     ' masst=13.0033 zt=6 qval=2.7220 /

 ! Exit #1: TOTAL
 &STATES jp=0.5 ptyp=1 ep=0.0000 cpot=2
         jt=1.5 ptyt=1 et=8.2000 /

 ! Exit #2: 0+ x 1d3/2 only
 &STATES copyp=1 cpot=2
         jt=1.5 ptyt=1 et=8.2000 /

 ! Exit #3: 2+ x 1d5/2 only
 &STATES copyp=1 cpot=2
         jt=1.5 ptyt=1 et=8.2000 /

 ! Exit #4: 2+ x 1d3/2 only
 &STATES copyp=1 cpot=2
         jt=1.5 ptyt=1 et=8.2000 /

 ! Exit #5: 2+ x 2s1/2 only
 &STATES copyp=1 cpot=2
         jt=1.5 ptyt=1 et=8.2000 /

 &PARTITION /

! ======================================================================
! POTENTIALS
! ======================================================================

! Entrance d + 12C potential and generalized 12C(0+)<->12C(2+) coupling
 &POT kp=1 type=0
      p(1:3)=12.000 0.0000 1.3000 /

 &POT kp=1 type=13 itt=F shape=10
      p(1:3)=0.000 -6.1600 0.0000 /
   &STEP ib=-2 ia=1 k=2 str=-6.160 /

 &POT kp=1 type=1
      p(1:3)=119.600 0.9000 0.8000 /

 &POT kp=1 type=-2
      p(1:7)=0.000 0.0000 0.0000 11.6000 1.4520 0.6210 0.0000 /

 &POT kp=1 type=13 itt=F shape=11
      p(1:3)=0.000 -1.4400 0.0000 /
   &STEP ib=-2 ia=1 k=2 str=-1.440 /

 &POT kp=1 type=3
      p(1:3)=1.300 0.9000 0.8000 /

! ----------------------------------------------------------------------
! Exit p + 13C Ohnuma OMP at the 8.20-MeV final-state kinematics
!
! Ecm(in)  = 16*12/(12+2.0141)          = 13.700487 MeV
! Qeff     = 2.7220 - 8.2000            = -5.478000 MeV
! Ecm(out) = 13.700487 - 5.478000       =  8.222487 MeV
!
! Ohnuma prescription:
!   V  = 63.1  - 0.3*Ecm(out) = 60.633254 MeV
!   WD = 10.37 - 0.06*Ecm(out)=  9.876651 MeV
!   r  = 1.15  - 0.001*Ecm(out)= 1.141778 fm
! ----------------------------------------------------------------------
 &POT kp=2 type=0 p(1:3)=13.000 0.0000 1.141778 /
 &POT kp=2 type=1 p(1:3)=60.633254 1.141778 0.5700 /
 &POT kp=2 type=2
      p(1:7)=0.0000 0.0000 0.0000 9.876651 1.141778 0.5000 0.0000 /
 &POT kp=2 type=3 p(1:3)=5.500 1.141778 0.5700 /

! Deuteron n-p binding potential
 &POT kp=3 type=0
      p(1:3)=1.000 0.0000 1.2500 /

 &POT kp=3 type=1 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=3 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=4 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

 &POT kp=3 type=7 itt=F shape=5
      p(1:3)=1.000 0.0000 1.0000 /

! Neutron + 12C radial potential
 &POT kp=4 type=0
      p(1:3)=13.000 0.0000 1.3000 /

 &POT kp=4 type=1
      p(1:3)=60.000 1.3000 0.7000 /

 &POT kp=4 type=3
      p(1:3)=6.500 1.3000 0.7000 /

 &POT /

! ======================================================================
! OVERLAPS
! ======================================================================

! KN=1: deuteron = p+n overlap
 &OVERLAP kn1=1 kn2=2 ic1=1 ic2=2 in=-1
    kind=3 ch1=' ' nn=1 l=0 lmax=2 sn=0.5 ia=1 j=1.5 ib=1
    kbpot=3 krpot=0 be=2.2246 isc=0 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! KN=3: 13C(8.20,3/2+) = 12C(0+) x 1d3/2
! Physical channel is open; artificial bound-state magnitude is used.
 &OVERLAP kn1=3 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=1.5
    kbpot=4 krpot=0 be=3.2540 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! KN=4: 13C(8.20,3/2+) = 12C(2+,4.4389) x 1d5/2
 &OVERLAP kn1=4 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=2.5
    kbpot=4 krpot=0 be=1.1849 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! KN=5: 13C(8.20,3/2+) = 12C(2+,4.4389) x 1d3/2
 &OVERLAP kn1=5 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=1 l=2 sn=0.5 j=1.5
    kbpot=4 krpot=0 be=1.1849 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

! KN=6: 13C(8.20,3/2+) = 12C(2+,4.4389) x 2s1/2
 &OVERLAP kn1=6 kn2=0 ic1=1 ic2=2 in=2
    kind=0 nn=2 l=0 sn=0.5 j=0.5
    kbpot=4 krpot=0 be=1.1849 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0000 /

 &OVERLAP /

! ======================================================================
! TRANSFER COUPLING + FSU9 SPECTROSCOPIC AMPLITUDES
! ======================================================================

 &COUPLING icto=-2 icfrom=1 kind=7 ip1=0 ip2=-2 ip3=0 /
   &CFP in=1 ib=1 ia=1 kn=1 a= 1.000000 /

   ! Exit #1: TOTAL coherent CCBA
   &CFP in=2 ib=1 ia=1 kn=3 a=-0.693451 /
   &CFP in=2 ib=1 ia=2 kn=4 a= 0.626193 /
   &CFP in=2 ib=1 ia=2 kn=5 a= 0.219101 /
   &CFP in=2 ib=1 ia=2 kn=6 a=-0.041683 /

   ! Exit #2: 0+ x 1d3/2 only
   &CFP in=2 ib=2 ia=1 kn=3 a=-0.693451 /
   &CFP in=2 ib=2 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=2 ia=2 kn=5 a= 0.000000 /
   &CFP in=2 ib=2 ia=2 kn=6 a= 0.000000 /

   ! Exit #3: 2+ x 1d5/2 only
   &CFP in=2 ib=3 ia=1 kn=3 a= 0.000000 /
   &CFP in=2 ib=3 ia=2 kn=4 a= 0.626193 /
   &CFP in=2 ib=3 ia=2 kn=5 a= 0.000000 /
   &CFP in=2 ib=3 ia=2 kn=6 a= 0.000000 /

   ! Exit #4: 2+ x 1d3/2 only
   &CFP in=2 ib=4 ia=1 kn=3 a= 0.000000 /
   &CFP in=2 ib=4 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=4 ia=2 kn=5 a= 0.219101 /
   &CFP in=2 ib=4 ia=2 kn=6 a= 0.000000 /

   ! Exit #5: 2+ x 2s1/2 only
   &CFP in=2 ib=5 ia=1 kn=3 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=4 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=5 a= 0.000000 /
   &CFP in=2 ib=5 ia=2 kn=6 a=-0.041683 /

   &CFP in=0 ib=0 ia=0 kn=0 a=0.000000 /

 ! Generalized entrance couplings are already defined in KP=1 above.
 &COUPLING /

! END OF FRESCO INPUT
