! ================================================
! OVERLAPS
! ================================================
! Mixing convention below:
!   f1 = S_L1/(S_L1+S_L3), f3 = 1-f1
!   A_L1 = sqrt(f1), A_L3 = sqrt(f3)
! so every mixed channel has S_L1+S_L3 = 1.0.
! All amplitudes are same-sign here; this scans mixture, not relative phase.

! --- IC=2 : pure L=1 ---
 &OVERLAP kn1=  1 kn2=  0 ic1=1 ic2=2 in= 1
          kind=0 nn= 2 l=0 sn= 0.0 j= 0.0
    kbpot= 3 krpot= 0 be=  1.4740 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1=  2 kn2=  0 ic1=1 ic2=2 in= 2
          kind=0 nn= 3 l=1 sn= 0.0 j= 1.0
    kbpot= 4 krpot= 0 be=  2.9680 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! --- IC=3 : pure L=3 ---
