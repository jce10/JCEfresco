 &OVERLAP kn1=  4 kn2=  0 ic1=1 ic2=3 in= 2
          kind=0 nn= 2 l=3 sn= 0.0 j= 3.0
    kbpot= 4 krpot= 0 be=  2.9680 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /

