9Be(6Li,d)13C at 32 MeV -- 10.812 MeV L=2/L=4 mixing-ratio scan
NAMELIST

! ================================================================
! FRESCO CONTROL PARAMETERS
! ================================================================
 &FRESCO  hcm= 0.100 rmatch=  30.000 rintp=  0.20
     hnl= 0.200 rnl= 10.00 centre= -0.80
     jtmin=  0.0 jtmax=    30.0 absend=  0.0000 dry=F rela=' ' nearfa= 0
     thmin=  0.00 thmax=180.00 thinc=  0.50 koords=1 kqmax=0 pp=0
     cutl=  0.00 cutr=  0.00 cutc=  0.00
     ips= 0.0000  it0=1 iter=  1 fatal=T iblock= 1 pade=0 nosol=F psiren=F
     iso=' ' nnu= 48 maxl=   0 minl=  0 mtmin= 0 epc= 0.0000
     chans= 1 listcc= 1 treneg= 0 cdetr= 0 smats= 1 xstabl= 3 nlpl= 0
     waves= 0 lampl= 0 veff= 1 kfus= 0 wdisk= 0 bpm= 1 melfil= 0
     unitmass= 1.000000 finec=137.03599
     inh=0 pel=1 exl= 1 lab=0 lin=0 lex= 0
     elab(1)=    32.0000 /

! ================================================================
! PARTITIONS AND STATES
!
! fort.16 map:
!   IC=2 : pure L=2
!   IC=3 : pure L=4
!   IC=4 : A4/A2 = -1.0
!   IC=5 : A4/A2 = -0.5
!   IC=6 : A4/A2 = +0.5
!   IC=7 : A4/A2 = +1.0
!
! The mixed channels keep A2 = 1.960, so A4 = r*A2.
! This preserves the normalization of the original L=2 calculation
! while scanning the relative L=4 amplitude and phase.
! ================================================================

! IC=1 : entrance channel
 &PARTITION namep='6Li     ' massp=  6.0151 zp=  3 nex= 1 pwf=T
            namet='9Be     ' masst=  9.0122 zt=  4 qval=  0.0000/
 &STATES jp= 1.0 ptyp= 1 ep=  0.0000  cpot=  1
         jt= 1.5 ptyt=-1 et=  0.0000/

! IC=2 : pure L=2
 &PARTITION namep='2H      ' massp=  2.0141 zp=  1 nex= 1 pwf=T
            namet='13C_L2  ' masst= 13.0034 zt=  6 qval=  9.1746/
 &STATES jp= 1.0 ptyp= 1 ep=  0.0000  cpot=  2
         jt= 2.5 ptyt=-1 et= 10.8120/

! IC=3 : pure L=4
 &PARTITION namep='2H      ' massp=  2.0141 zp=  1 nex= 1 pwf=T
            namet='13C_L4  ' masst= 13.0034 zt=  6 qval=  9.1746/
 &STATES jp= 1.0 ptyp= 1 ep=  0.0000  cpot=  2
         jt= 2.5 ptyt=-1 et= 10.8120/

! IC=4 : mixed L=2+4, A4/A2 = -1.0
 &PARTITION namep='2H      ' massp=  2.0141 zp=  1 nex= 1 pwf=T
            namet='13C_m10 ' masst= 13.0034 zt=  6 qval=  9.1746/
 &STATES jp= 1.0 ptyp= 1 ep=  0.0000  cpot=  2
         jt= 2.5 ptyt=-1 et= 10.8120/

! IC=5 : mixed L=2+4, A4/A2 = -0.5
 &PARTITION namep='2H      ' massp=  2.0141 zp=  1 nex= 1 pwf=T
            namet='13C_m05 ' masst= 13.0034 zt=  6 qval=  9.1746/
 &STATES jp= 1.0 ptyp= 1 ep=  0.0000  cpot=  2
         jt= 2.5 ptyt=-1 et= 10.8120/

! IC=6 : mixed L=2+4, A4/A2 = +0.5
 &PARTITION namep='2H      ' massp=  2.0141 zp=  1 nex= 1 pwf=T
            namet='13C_p05 ' masst= 13.0034 zt=  6 qval=  9.1746/
 &STATES jp= 1.0 ptyp= 1 ep=  0.0000  cpot=  2
         jt= 2.5 ptyt=-1 et= 10.8120/

! IC=7 : mixed L=2+4, A4/A2 = +1.0
 &PARTITION namep='2H      ' massp=  2.0141 zp=  1 nex= 1 pwf=T
            namet='13C_p10 ' masst= 13.0034 zt=  6 qval=  9.1746/
 &STATES jp= 1.0 ptyp= 1 ep=  0.0000  cpot=  2
         jt= 2.5 ptyt=-1 et= 10.8120/

 &partition /   ! END OF DEFINING PARTITIONS

! ================================================================
! POTENTIALS -- unchanged from original 10.812-MeV card
! ================================================================
 &pot kp= 1 type= 0
      p(1:3)=    9.000  0.0000  2.3400 /
 &pot kp= 1 type= 1
      p(1:7)=  174.000  1.2200  0.7500  5.8400  2.8100  0.6300  0.0000 /
 &pot kp= 2 type= 0
      p(1:3)=   13.000  0.0000  1.3000 /
 &pot kp= 2 type= 1
      p(1:3)=   92.410  1.0380  0.7900 /
 &pot kp= 2 type= 2
      p(1:7)=    0.000  0.0000  0.0000  9.7500  1.4260  0.6930  0.0000 /
 &pot kp= 3 type= 0
      p(1:3)=    1.000  0.0000  1.9000 /
 &pot kp= 3 type= 1
      p(1:3)=   79.900  1.9000  0.6500 /
 &pot kp= 4 type= 0
      p(1:3)=    1.000  0.0000  2.7600 /
 &pot kp= 4 type= 1
      p(1:3)=   50.000  2.7600  0.6500 /
 &pot /   ! END OF DEFINING POTENTIALS

! ================================================================
! OVERLAPS
!
! Projectile overlap in every diagnostic channel:
!   6Li = d + alpha : nn=2, l=0, j=0, BE=1.474 MeV
!
! Final-state alpha overlaps:
!   L=2 : nn=2, l=2, j=2
!   L=4 : nn=1, l=4, j=4
! Both use the same 0.164-MeV binding energy and kbpot=4.
! ================================================================

! --- IC=1 <-> IC=2 : pure L=2 ---
 &OVERLAP kn1=  1 kn2=  0 ic1=1 ic2=2 in= 1
          kind=0 nn= 2 l=0 sn= 0.0 j= 0.0
    kbpot= 3 krpot= 0 be=  1.4740 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1=  2 kn2=  0 ic1=1 ic2=2 in= 2
          kind=0 nn= 2 l=2 sn= 0.0 j= 2.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! --- IC=1 <-> IC=3 : pure L=4 ---
 &OVERLAP kn1=  3 kn2=  0 ic1=1 ic2=3 in= 1
          kind=0 nn= 2 l=0 sn= 0.0 j= 0.0
    kbpot= 3 krpot= 0 be=  1.4740 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1=  4 kn2=  0 ic1=1 ic2=3 in= 2
          kind=0 nn= 1 l=4 sn= 0.0 j= 4.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! --- IC=1 <-> IC=4 : A4/A2 = -1.0 ---
 &OVERLAP kn1=  5 kn2=  0 ic1=1 ic2=4 in= 1
          kind=0 nn= 2 l=0 sn= 0.0 j= 0.0
    kbpot= 3 krpot= 0 be=  1.4740 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1=  6 kn2=  0 ic1=1 ic2=4 in= 2
          kind=0 nn= 2 l=2 sn= 0.0 j= 2.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1=  7 kn2=  0 ic1=1 ic2=4 in= 2
          kind=0 nn= 1 l=4 sn= 0.0 j= 4.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! --- IC=1 <-> IC=5 : A4/A2 = -0.5 ---
 &OVERLAP kn1=  8 kn2=  0 ic1=1 ic2=5 in= 1
          kind=0 nn= 2 l=0 sn= 0.0 j= 0.0
    kbpot= 3 krpot= 0 be=  1.4740 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1=  9 kn2=  0 ic1=1 ic2=5 in= 2
          kind=0 nn= 2 l=2 sn= 0.0 j= 2.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1= 10 kn2=  0 ic1=1 ic2=5 in= 2
          kind=0 nn= 1 l=4 sn= 0.0 j= 4.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! --- IC=1 <-> IC=6 : A4/A2 = +0.5 ---
 &OVERLAP kn1= 11 kn2=  0 ic1=1 ic2=6 in= 1
          kind=0 nn= 2 l=0 sn= 0.0 j= 0.0
    kbpot= 3 krpot= 0 be=  1.4740 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1= 12 kn2=  0 ic1=1 ic2=6 in= 2
          kind=0 nn= 2 l=2 sn= 0.0 j= 2.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1= 13 kn2=  0 ic1=1 ic2=6 in= 2
          kind=0 nn= 1 l=4 sn= 0.0 j= 4.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /

! --- IC=1 <-> IC=7 : A4/A2 = +1.0 ---
 &OVERLAP kn1= 14 kn2=  0 ic1=1 ic2=7 in= 1
          kind=0 nn= 2 l=0 sn= 0.0 j= 0.0
    kbpot= 3 krpot= 0 be=  1.4740 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1= 15 kn2=  0 ic1=1 ic2=7 in= 2
          kind=0 nn= 2 l=2 sn= 0.0 j= 2.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /
 &OVERLAP kn1= 16 kn2=  0 ic1=1 ic2=7 in= 2
          kind=0 nn= 1 l=4 sn= 0.0 j= 4.0
    kbpot= 4 krpot= 0 be=  0.1640 isc= 1 ipc=0 nfl=0 nam=0 ampl=0.0000 /

 &overlap /   ! END OF DEFINING OVERLAPS

! ================================================================
! COUPLINGS
!
! Original amplitudes:
!   projectile alpha+d CFP = 0.8307
!   reference target alpha+9Be amplitude = 1.9600
!
! For mixed channels:
!   A2 = 1.9600
!   A4 = r * 1.9600
! ================================================================

! IC=2 : pure L=2
 &COUPLING icto=-2 icfrom=1 kind=7 ip1=0 ip2=-1 ip3=0 /
   &cfp in= 1 ib=1 ia=1 kn= 1 a= 0.8307 /
   &cfp in=-2 ib=1 ia=1 kn= 2 a= 1.9600 /

! IC=3 : pure L=4
 &COUPLING icto=-3 icfrom=1 kind=7 ip1=0 ip2=-1 ip3=0 /
   &cfp in= 1 ib=1 ia=1 kn= 3 a= 0.8307 /
   &cfp in=-2 ib=1 ia=1 kn= 4 a= 1.9600 /

! IC=4 : A4/A2 = -1.0  --> A2=+1.9600, A4=-1.9600
 &COUPLING icto=-4 icfrom=1 kind=7 ip1=0 ip2=-1 ip3=0 /
   &cfp in= 1 ib=1 ia=1 kn= 5 a= 0.8307 /
   &cfp in= 2 ib=1 ia=1 kn= 6 a= 1.9600 /   ! L=2
   &cfp in=-2 ib=1 ia=1 kn= 7 a=-1.9600 /   ! L=4

! IC=5 : A4/A2 = -0.5  --> A2=+1.9600, A4=-0.9800
 &COUPLING icto=-5 icfrom=1 kind=7 ip1=0 ip2=-1 ip3=0 /
   &cfp in= 1 ib=1 ia=1 kn= 8 a= 0.8307 /
   &cfp in= 2 ib=1 ia=1 kn= 9 a= 1.9600 /   ! L=2
   &cfp in=-2 ib=1 ia=1 kn=10 a=-0.9800 /   ! L=4

! IC=6 : A4/A2 = +0.5  --> A2=+1.9600, A4=+0.9800
 &COUPLING icto=-6 icfrom=1 kind=7 ip1=0 ip2=-1 ip3=0 /
   &cfp in= 1 ib=1 ia=1 kn=11 a= 0.8307 /
   &cfp in= 2 ib=1 ia=1 kn=12 a= 1.9600 /   ! L=2
   &cfp in=-2 ib=1 ia=1 kn=13 a= 0.9800 /   ! L=4

! IC=7 : A4/A2 = +1.0  --> A2=+1.9600, A4=+1.9600
 &COUPLING icto=-7 icfrom=1 kind=7 ip1=0 ip2=-1 ip3=0 /
   &cfp in= 1 ib=1 ia=1 kn=14 a= 0.8307 /
   &cfp in= 2 ib=1 ia=1 kn=15 a= 1.9600 /   ! L=2
   &cfp in=-2 ib=1 ia=1 kn=16 a= 1.9600 /   ! L=4

 &COUPLING icto=0 icfrom=1 kind=1 ip1=0 ip2=0 ip3=0 /
 ! *******  END OF FRESCO INPUTS *******
